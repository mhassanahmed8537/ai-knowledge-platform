ENVIRONMENT=local

# --- Database roles (async asyncpg driver) ---
# Runtime, RLS-enforced least-privilege role (all authenticated business logic).
DATABASE_URL=postgresql+asyncpg://app_user:app_password@localhost:5432/knowledge_platform
# Trusted auth subsystem role (BYPASSRLS) — login/signup/refresh/oauth only.
AUTH_DATABASE_URL=postgresql+asyncpg://app_auth:auth_password@localhost:5432/knowledge_platform
# Superuser/owner role used exclusively by Alembic migrations.
MIGRATION_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/knowledge_platform

REDIS_URL=redis://localhost:6379/0

# --- MinIO (S3-compatible) local object storage ---
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=documents

# --- Auth / JWT ---
JWT_SECRET=dev-insecure-change-me-0123456789abcdef
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=1209600

# --- OAuth (Phase 1d; leave blank to disable a provider) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
OAUTH_REDIRECT_BASE_URL=http://localhost:8000

# --- Ingestion (Phase 2) ---
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
MAX_UPLOAD_BYTES=26214400
# Embeddings: "fake" (deterministic, zero-cost), "openai", or "gemini"
EMBEDDING_PROVIDER=fake
EMBEDDING_DIM=1536
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
GEMINI_API_KEY=
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# --- Generation (Phase 4) ---
# "stub" (deterministic, zero-cost), "anthropic", "openai", or "gemini"
LLM_PROVIDER=stub
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-8
OPENAI_CHAT_MODEL=gpt-4o-mini
GEMINI_CHAT_MODEL=gemini-2.5-flash
LLM_MAX_TOKENS=4096
LLM_EFFORT=medium
